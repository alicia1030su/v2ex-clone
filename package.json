{
  "name": "v2ex-clone",
  "version": "0.0.20",
  "description": "V2EX 高保真全栈复刻工程 —— 独立技术研究项目，与 V2EX 官方无关联",
  "license": "MIT",
  "keywords": [
    "forum",
    "nextjs",
    "drizzle",
    "postgresql",
    "clone"
  ],
  "homepage": "https://github.com/alicia1030su/v2ex-clone#readme",
  "bugs": {
    "url": "https://github.com/alicia1030su/v2ex-clone/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alicia1030su/v2ex-clone.git"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prestart": "node scripts/migrate-legacy-uploads.mjs",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "admin": "tsx scripts/admin-cli.ts",
    "memory:preflight": "node tools/dev-memory/preflight.mjs",
    "memory:monitor": "node tools/dev-memory/monitor.mjs",
    "memory:cleanup": "node tools/dev-memory/cleanup.mjs",
    "memory:run": "node tools/dev-memory/run.mjs",
    "memory:benchmark": "node tools/dev-memory/benchmark.mjs",
    "dev:low": "node tools/dev-memory/run.mjs --profile next-dev -- npm run dev",
    "build:low": "node tools/dev-memory/run.mjs --profile next-build -- npm run build",
    "test:unit:low": "node tools/dev-memory/run.mjs --profile vitest -- node node_modules/vitest/vitest.mjs run --config vitest.low.config.ts",
    "test:e2e:low": "node tools/dev-memory/run.mjs --profile playwright -- node node_modules/playwright/cli.js test --config playwright.low.config.ts",
    "visual:audit:low": "node tools/dev-memory/run.mjs --profile visual-audit -- node tools/visual/v021/run-audit.mjs --managed-server",
    "test:e2e": "playwright test",
    "test:unit": "vitest run"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "marked": "^18.1.2",
    "next": "15.5.29",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "esbuild": "^0.28.0"
  }
}
