# ---------------------------------------------------------------------------
# V2EX Clone — 环境变量模板
# 复制为 .env.local 后填写。所有密钥均为示例值，请务必替换。
# ---------------------------------------------------------------------------

# PostgreSQL —— 本地 Docker Compose 默认值
DATABASE_URL=postgres://v2ex:v2ex_password@127.0.0.1:5432/v2ex
DATABASE_POOL_MAX=10

# Redis —— 用于会话缓存 / 限流 / 计数
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

# 会话签名密钥（生产环境必须替换为 32+ 随机字符）
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# 应用地址（用于回调与绝对链接）
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 初始管理员（seed 脚本使用）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345

# 原站抓取代理（阶段一逆向调查用；本地开发不需要）
# 本机 xray HTTP 代理；留空则直连
V2_PROXY=http://127.0.0.1:10001

# 限流阈值（每窗口）
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_POST_MAX=5
RATE_LIMIT_REPLY_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60
