# ---------------------------------------------------------------------------
# V2EX Clone — 环境变量模板
# 复制为 .env 或 .env.local 后填写。
#
# 安全要求：本模板不提供任何可用的默认口令。
# 带 ${...} 标记的变量在 docker compose 中没有默认值，
# 未设置时容器会直接启动失败，而不是带着弱口令运行。
# ---------------------------------------------------------------------------

# --- 运行时环境 -------------------------------------------------------
# production | staging | test | development
# test 环境才允许使用 DISABLE_CAPTCHA / TEST_ENV_ISOLATED 等测试专用开关。
APP_RUNTIME_ENV=development

# --- PostgreSQL -------------------------------------------------------
POSTGRES_USER=v2ex
POSTGRES_DB=v2ex
# 必须设置强口令，无默认值
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgres://v2ex:CHANGE_ME@127.0.0.1:5432/v2ex
DATABASE_POOL_MAX=10

# --- Redis（可选，缺失时自动降级到 PostgreSQL）-----------------------
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379

# --- 应用 -------------------------------------------------------------
# 会话签名密钥，必须为 32 位以上随机串
SESSION_SECRET=
APP_URL=http://localhost:3000
# 公开访问地址（反代 / 多域名部署必填）。用于找回密码邮件里的重置链接 ——
# v0.0.8 起该链接**只信此配置**（PUBLIC_BASE_URL → APP_URL），
# 未配置时拒绝发信（fail-closed，防止 Host 头投毒劫持重置令牌）。
# 本地单机部署可留空（自动用 APP_URL）。
PUBLIC_BASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 初始管理员（seed 使用）-----------------------------------------
# 生产环境必须显式设置，且密码长度 ≥ 12
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# 演示账号（lisi/wangwu/zhaoliu/moderator）：仅非生产环境创建
# 设为 0 可完全禁用；生产环境自动禁用
SEED_DEMO_USERS=1
SEED_DEMO_PASSWORD=

# --- 限流 -------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_POST_MAX=5
RATE_LIMIT_REPLY_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REPLY_WINDOW_SECONDS=120
RATE_LIMIT_CREATE_NODE_MAX=10
RATE_LIMIT_CREATE_NODE_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_IP_MAX=20
RATE_LIMIT_REGISTER_WINDOW_SECONDS=300

# --- 调试端点（生产必须关闭）-----------------------------------------
# 开启后仍需 DEBUG_ENDPOINT_TOKEN 才能访问
ENABLE_DEBUG_ENDPOINTS=0
DEBUG_ENDPOINT_TOKEN=

# --- 测试专用（仅 APP_RUNTIME_ENV=test 且 TEST_ENV_ISOLATED=1 时生效）--
# 在 production / staging 下即使误配也会被忽略
TEST_ENV_ISOLATED=0
DISABLE_CAPTCHA=0

# --- 原站抓取代理（仅阶段一逆向调查使用，本地开发不需要）--------------
V2_PROXY=http://127.0.0.1:10001
