{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbuddy-v021/visual-matrix-record/v1",
  "title": "V2EX v0.0.21 visual fidelity matrix record",
  "type": "object",
  "required": [
    "gap_id", "page_class", "route", "auth_role", "viewport", "layer",
    "reference_id", "reference_url_or_path", "captured_at", "legal_basis",
    "baseline_selector", "baseline_value", "current_selector", "current_value",
    "delta", "classification", "severity", "status", "evidence_before",
    "evidence_after", "owner", "commit", "retest_result", "notes",
    "states", "probe_results", "p0_blocking", "closure_allowed"
  ],
  "properties": {
    "gap_id": { "type": "string", "pattern": "^V21-P(0[1-9]|1[0-8])-VP(375|390|768|1280|1920)-L[1-6]-R[0-9]{2}$" },
    "page_class": { "type": "string", "minLength": 1 },
    "route": { "type": "string", "minLength": 1 },
    "auth_role": { "enum": ["guest", "user", "moderator", "admin"] },
    "viewport": { "enum": ["mobile-375", "mobile-390", "tablet-768", "desktop-1280", "desktop-1920"] },
    "layer": { "enum": ["L1", "L2", "L3", "L4", "L5", "L6"] },
    "reference_id": { "type": "string", "minLength": 1 },
    "reference_url_or_path": { "type": ["string", "null"] },
    "captured_at": { "type": "string", "format": "date-time" },
    "legal_basis": { "type": "string", "minLength": 1 },
    "baseline_selector": { "type": "string" },
    "baseline_value": {},
    "current_selector": { "type": "string" },
    "current_value": {},
    "delta": {},
    "classification": { "enum": ["A", "B", "C", "D", "E"] },
    "severity": { "enum": ["P0", "P1", "P2"] },
    "status": { "enum": ["VERIFIED", "INTENTIONAL_DIFFERENCE", "UNVERIFIED"] },
    "evidence_before": { "type": "string", "minLength": 1 },
    "evidence_after": { "type": ["string", "null"] },
    "owner": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "retest_result": { "type": "string" },
    "notes": { "type": "string", "minLength": 1 },
    "states": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "probe_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["probe", "status"],
        "properties": {
          "probe": { "type": "string" },
          "status": { "type": "string" },
          "evidence": { "type": ["string", "null"] }
        }
      },
      "minItems": 1
    },
    "p0_blocking": { "type": "boolean" },
    "closure_allowed": { "type": "boolean" }
  }
}
