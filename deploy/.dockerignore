# ---------------------------------------------------------------------------
# V2EX Clone v0.0.15 — 发布包构建上下文排除规则
#
# 目的：确保 .env / INSTALL_CREDENTIALS.txt / 备份文件 / 逆向调查素材
#      永远不会进入镜像或推送上下文。
#
# 说明：发布版 docker-compose.yml 默认拉取**预构建镜像**，不在用户机器上构建。
#       本文件是给需要本地构建镜像的场景（例如私有镜像仓库）用的兜底。
# ---------------------------------------------------------------------------

# --- 环境与密钥（绝不能进镜像）---------------------------------------
.env
.env.*
!.env.example
INSTALL_CREDENTIALS.txt

# --- Git ------------------------------------------------------------------
.git
.gitignore
.gitattributes

# --- 依赖 ----------------------------------------------------------------
node_modules
npm-debug.log*
yarn-error.log*
pnpm-lock.yaml
.pnpm-store

# --- 构建产物 ------------------------------------------------------------
.next
out
dist
build
*.tsbuildinfo

# --- 测试产物 ------------------------------------------------------------
test-results
playwright-report
blob-report
coverage
.nyc_output
e2e

# --- 运行时与缓存 --------------------------------------------------------
.cache
tmp
logs
*.log
.pid

# --- 备份与归档（可能含真实凭据，绝不能进镜像）-------------------------
_backups
backup
backups
*.tar.gz
*.tgz
*.zip
*.sql.gz
*.dump
*.backup
pgdata/

# --- 数据库导出（绝不能进镜像或仓库）----------------------------------
# 注意：drizzle/*.sql 是迁移脚本，必须包含在镜像内
*.sql
!drizzle/*.sql

# --- 逆向调查的一手证据（体积大且含第三方内容，不进镜像）--------------
docs/evidence/html/
docs/evidence/assets/
docs/evidence/screenshots/
docs/evidence/visual/

# --- 编辑器与系统 --------------------------------------------------------
.vscode
.idea
.DS_Store
Thumbs.db
desktop.ini

# --- 发布包自身的脚本（容器里用不到）-----------------------------------
deploy/
