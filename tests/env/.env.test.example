# ---------------------------------------------------------------------------
# 单元测试 / E2E 隔离环境模板（v0.0.4）
# ---------------------------------------------------------------------------
#
# ⚠️ 本模板**不含任何真实口令** —— 全部使用 `__占位符__` 形式。
# 入库安全（对照 `.env.example` 的「本模板不提供任何可用的默认口令」基线）。
#
# ## 它解决什么问题
#
# 修复前 `.env.test` **从未入仓**，于是：
#   - `tests/floor-continuity.spec.ts` 在 CI 上直接读 `.env.test` → **ENOENT 必崩**；
#   - 新克隆的仓库**开箱无法跑单元测试**。
#
# 现在：
#   - 本模板**入仓**，作为「哪些变量是测试专用」的文档；
#   - `tests/helpers/test-env.ts` 在 `.env.test` 缺失时**自动生成本机副本**，
#     并把占位符换成本机固定测试值（仅本机隔离实例使用，与真实凭据无交集）；
#   - 生成的 `.env.test` 已被 `.gitignore` 覆盖，**不会入库**。
#
# ## 手动生成
#
#   cp tests/env/.env.test.example .env.test
#
# ## 加载优先级（唯一且显式）
#
#   process.env（shell / CI） > ENV_FILE > .env.test > .env
#   （`.env.local` 在单元测试流程中**永不加载** —— 它指向开发库）
#
# ---------------------------------------------------------------------------

# ---- 数据库 ----
# 本机隔离测试实例由 `bash tests/helpers/start-test-pg.sh start` 启动，
# 默认监听 127.0.0.1:55440，数据目录 `data-test-v004`（与开发实例完全独立）。
DATABASE_URL=postgres://v2ex:__TEST_DB_PASSWORD__@__TEST_DB_HOST__:__TEST_DB_PORT__/__TEST_DB_NAME__

# 连接池上限（单元测试用小值，避免与其它测试文件争抢连接数）
DATABASE_POOL_MAX=5

# ---- 运行时开关 ----
# 必须是 test + TEST_ENV_ISOLATED=1，否则验证码等安全机制不会被跳过
APP_RUNTIME_ENV=test
TEST_ENV_ISOLATED=1
NODE_ENV=test

# ---- 会话密钥（仅本机隔离实例使用）----
SESSION_SECRET=__TEST_SESSION_SECRET__

# ---- 应用地址 ----
APP_URL=http://localhost:3010
NEXT_PUBLIC_APP_URL=http://localhost:3010

# ---- Redis ----
# 留空 → 降级到 PostgreSQL 表实现（与现有本机行为一致）
REDIS_URL=
REDIS_PASSWORD=

# ---- Seed 初始账号（仅本机隔离实例使用）----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@test.local
SEED_ADMIN_PASSWORD=__TEST_DB_PASSWORD__
SEED_DEMO_USERS=1
SEED_DEMO_PASSWORD=__TEST_DB_PASSWORD__

# ---- 调试端点（仅隔离测试环境允许开启）----
ENABLE_DEBUG_ENDPOINTS=1
DEBUG_ENDPOINT_TOKEN=__TEST_DB_PASSWORD__

# ---- 验证码（隔离测试环境跳过）----
DISABLE_CAPTCHA=1

# ---- 限流阈值 ----
# 与生产保持一致默认值 —— E2E 有专门用例验证限流生效，调高会让它们永远等不到 429。
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_POST_MAX=5
RATE_LIMIT_REPLY_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REPLY_WINDOW_SECONDS=120
RATE_LIMIT_CREATE_NODE_MAX=10
RATE_LIMIT_CREATE_NODE_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_IP_MAX=20
RATE_LIMIT_REGISTER_WINDOW_SECONDS=300
