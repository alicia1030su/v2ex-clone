# ---------------------------------------------------------------------------
# V2EX Clone v0.0.2 — 发行版环境变量模板
#
# 用法：无需手工创建 .env。运行 ./install.sh（Linux/macOS）或
#       powershell -ExecutionPolicy Bypass -File .\install.ps1（Windows），
#       安装脚本会复制本模板为 .env 并自动填入随机口令。
#
# 安全要求：本模板**不提供任何可用的默认口令**。
# 留空的项由 install.sh / install.ps1 自动生成随机值后写入 .env。
# .env 含明文凭据，请勿提交到版本库（仓库已通过 .gitignore 忽略它）。
# ---------------------------------------------------------------------------

# --- 镜像与端口 ---------------------------------------------------------
# 应用镜像（发行版拉取预构建镜像，无需本地构建）
V2EX_IMAGE=ghcr.io/alicia1030su/v2ex-clone:v0.0.2
# Compose 项目名：固定后数据卷名称稳定，备份/恢复脚本可精确定位
COMPOSE_PROJECT_NAME=v2ex
# 宿主机映射端口（改端口后记得同步改 APP_URL / NEXT_PUBLIC_APP_URL）
APP_PORT=3000
# 对外访问地址（会话 Cookie 的 secure 标记依赖正确的主机名）
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 运行时环境 ---------------------------------------------------------
# production | staging | test | development
# 生产环境请保持 production：验证码与调试端点在其它环境下行为不同。
APP_RUNTIME_ENV=production

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_USER=v2ex
POSTGRES_DB=v2ex
# 由 install.sh / install.ps1 自动生成随机值（≥24 位随机十六进制串）
POSTGRES_PASSWORD=

# --- Redis --------------------------------------------------------------
# 由 install.sh / install.ps1 自动生成随机值（≥24 位随机十六进制串）
REDIS_PASSWORD=

# --- 应用 ---------------------------------------------------------------
# 会话签名密钥：由 install.sh / install.ps1 自动生成随机值（≥32 位随机十六进制串）
SESSION_SECRET=

# --- 初始管理员（seed 使用）--------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
# 由 install.sh / install.ps1 自动生成随机值（≥12 位，含大小写字母与数字）
SEED_ADMIN_PASSWORD=

# --- 演示数据 -----------------------------------------------------------
# 0 = 不创建演示账号（生产环境推荐；生产环境也会强制禁用）
SEED_DEMO_USERS=0

# --- 限流（可选，保持默认值即可）---------------------------------------
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_POST_MAX=5
RATE_LIMIT_REPLY_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REPLY_WINDOW_SECONDS=120
RATE_LIMIT_CREATE_NODE_MAX=10
RATE_LIMIT_CREATE_NODE_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_IP_MAX=20
RATE_LIMIT_REGISTER_WINDOW_SECONDS=300

# --- 可信代理（安全相关，默认关闭） ---
# 是否采信 x-forwarded-for / x-real-ip 作为客户端真实 IP。
# 0（默认）：完全忽略这些头 —— 因为应用端口直接映射到宿主机时，
#             客户端可任意伪造它们从而绕过限流。
#             代价：IP 维度限流退化为全局单桶（账号维度限流仍有效）。
# 1：仅当应用确定部署在反向代理之后、且代理会**覆盖**（而非追加）
#    x-forwarded-for 时才开启。
TRUST_PROXY_HEADERS=0
